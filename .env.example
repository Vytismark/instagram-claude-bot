# Copy this file to .env and fill in your own values:
#     cp .env.example .env
#
# Never commit your real .env file. It is gitignored by default.
# Wrap values in double quotes if they contain a # or spaces.

# ---- Required ----

# The Instagram account the bot posts as. Use a throwaway/secondary account,
# not your main one. See the README for why.
IG_USERNAME="your_instagram_username"
IG_PASSWORD="your_instagram_password"

# The group chat to watch. See README "Finding your THREAD_ID".
THREAD_ID="000000000000000000000000000000000000000"

# From https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY="sk-ant-..."


# ---- Bot identity (optional, has defaults) ----

# What the bot calls itself.
BOT_NAME="Computah"

# The word that summons it. Case-insensitive, matched anywhere in a message.
WATCH_WORD="computah"

# One line describing its personality. This gets dropped straight into the
# system prompt, so write it the way you would describe a person.
BOT_PERSONALITY="dry sense of humor, blunt, genuine opinions, not eager to please"


# ---- Tuning (optional, has defaults) ----

# Seconds between checks for new messages. Going much below 10 increases
# your chances of getting rate limited or flagged by Instagram.
POLL_INTERVAL_SECONDS="10"

# How many recent messages to fetch per check.
MESSAGES_PER_POLL="20"

# How many recent messages the bot sees word-for-word. Kept small on purpose:
# long-range context comes from the rolling summary instead, which is cheaper.
RECENT_CONTEXT_MESSAGES="10"

# How many of its own past exchanges the bot remembers. Higher means better
# continuity but more tokens per reply.
MAX_HISTORY_TURNS="8"

# Refresh the rolling chat summary after this many new messages.
SUMMARY_UPDATE_THRESHOLD="30"

# Refresh a person's persona note after this many messages from them.
PERSONA_UPDATE_THRESHOLD="15"


# ---- Claude (optional, has defaults) ----

# Haiku is fast and cheap, which suits short chat replies. Swap for a larger
# model if you want wittier output and don't mind the cost.
CLAUDE_MODEL="claude-haiku-4-5-20251001"

# Max length of a reply. Lower values keep it snappy.
CLAUDE_MAX_TOKENS="300"


# ---- Storage (optional) ----

# Where session, personas, summary and logs are written. Gitignored.
DATA_DIR="data"
